PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Só habilite atrás de um proxy reverso confiável (Caddy/Nginx). Aceita true ou o IP/CIDR do
# proxy (ex.: 127.0.0.1). Deixe false se o backend recebe conexões diretas.
TRUST_PROXY=false
# Defina uma chave forte em produção (mínimo 32 caracteres)
JWT_SECRET=
DB_PATH=./data/twcin.db
# Opcional: preencher para criar o primeiro usuário via variável de ambiente
# Caso contrário, a criação ocorre na tela inicial do sistema
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
