PORT=3333
HOST=0.0.0.0
# Em desenvolvimento (Vite separado): http://localhost:5173
# Em servidor único (SERVE_FRONTEND=true), acessos pelo mesmo IP/host funcionam automaticamente;
# adicione outras origens separadas por vírgula se houver proxy com domínio externo.
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Só habilite atrás de um proxy reverso confiável (Caddy/Nginx/IIS). Aceita true ou o IP/CIDR do
# proxy (ex.: 127.0.0.1). Deixe false se o backend recebe conexões diretas.
TRUST_PROXY=false
# Defina uma chave forte em produção (mínimo 32 caracteres). Se vazio, gera e salva em .jwt_secret
JWT_SECRET=
# Opcional: diretório base para banco e backups automáticos (padrão: ./data)
DATA_DIR=
DB_PATH=./data/twcin.db
BACKUP_DIR=
# Frequência do backup automático em disco em horas (em produção o padrão é 24h; 0 desativa)
AUTO_BACKUP_HOURS=24
AUTO_BACKUP_RETAIN=14
# Nível de log do servidor: fatal, error, warn, info, debug
LOG_LEVEL=info
LOG_REQUESTS=false
# Opcional: preencher para criar o primeiro usuário via variável de ambiente
# Caso contrário, a criação ocorre na tela inicial do sistema
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# Em produção sem Caddy/Nginx separado, defina SERVE_FRONTEND=true após rodar `npm run build`
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=
